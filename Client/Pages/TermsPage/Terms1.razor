@page "/terms1"
@using Markdig
@inject Microsoft.Extensions.Localization.IStringLocalizer<Terms> L
@inject HttpClient Http

<PageTitle>@L["Title"]</PageTitle>
<RadzenCard Style="background-color: rgba(255, 255, 255, 0)">
    <article class="terms">@body</article>
</RadzenCard>

<style>
.terms { max-width: 860px; margin: 0 auto; line-height: 1.6; }
</style>
@code {
    private const string MarkdownPath = "terms/Terms%20of%20Use%20for%20Poly%20Translator.md";
    private MarkupString body;

    protected override async Task OnInitializedAsync()
    {
        var markdown = await Http.GetStringAsync(MarkdownPath);
        body = new MarkupString(Markdown.ToHtml(markdown, new MarkdownPipelineBuilder().DisableHtml().Build()));
    }
}
